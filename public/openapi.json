        ],
        "responses": {
          "200": {
            "description": "対象タスク",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/taskResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "put": {
        "operationId": "put-tasks-{id}",
        "summary": "タスクを更新",
        "description": "タイトル・説明・ステータスを部分更新する。",
        "tags": [
          "Tasks"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "description": "タスクID"
            },
            "description": "タスクID",
            "example": "123"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/updateTaskSchema"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新後のタスク",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/taskResponseSchema"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        }
      },
      "delete": {
        "operationId": "delete-tasks-{id}",
        "summary": "タスクを削除",
        "description": "deletedAt を設定する論理削除。",
